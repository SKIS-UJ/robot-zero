<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <!-- FRONT WHEELS -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>

            <wheel_separation>${wheel_offset_y * 2}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <max_linear_acceleration>${max_wheel_acceleration}</max_linear_acceleration>
            <min_linear_acceleration>-${max_wheel_acceleration}</min_linear_acceleration>
            <max_angular_acceleration>${max_wheel_acceleration * 2}</max_angular_acceleration>
            <min_angular_acceleration>-${max_wheel_acceleration * 2}</min_angular_acceleration>
            
            <max_linear_velocity>${max_wheel_velocity}</max_linear_velocity>
            <min_linear_velocity>-${max_wheel_velocity}</min_linear_velocity>
            <max_angular_velocity>${max_wheel_velocity * 2}</max_angular_velocity>
            <min_angular_velocity>-${max_wheel_velocity * 2}</min_angular_velocity>

            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <!-- BACK WHEELS -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>back_left_wheel_joint</left_joint>
            <right_joint>back_right_wheel_joint</right_joint>

            <wheel_separation>${wheel_offset_y * 2}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <max_linear_acceleration>${max_wheel_acceleration}</max_linear_acceleration>
            <min_linear_acceleration>-${max_wheel_acceleration}</min_linear_acceleration>
            <max_angular_acceleration>${max_wheel_acceleration * 2}</max_angular_acceleration>
            <min_angular_acceleration>-${max_wheel_acceleration * 2}</min_angular_acceleration>
            
            <max_linear_velocity>${max_wheel_velocity}</max_linear_velocity>
            <min_linear_velocity>-${max_wheel_velocity}</min_linear_velocity>
            <max_angular_velocity>${max_wheel_velocity * 2}</max_angular_velocity>
            <min_angular_velocity>-${max_wheel_velocity * 2}</min_angular_velocity>

            <topic>cmd_vel</topic>
            <odom_publish_frequency>0</odom_publish_frequency>
        </plugin>
        
    </gazebo>

</robot>