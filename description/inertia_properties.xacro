<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Cuboid -->
    <xacro:macro name="cuboid_inertia" params="mass width height depth *origin">
        <xacro:property name="h" value="${height*height}"/>
        <xacro:property name="w" value="${width*width}"/>
        <xacro:property name="d" value="${depth*depth}"/>
        <xacro:property name="m" value="${1/12*mass}"/>
        <inertial>
                <xacro:insert_block name="origin"/>
                <mass value="${mass}" />
                <inertia ixx="${m*(h+d)}" ixy="0.0" ixz="0.0"
                    iyy="${m*(w+d)}" iyz="0.0"
                    izz="${m*(w+h)}" />
        </inertial>
    </xacro:macro>

    <!-- Cylinder -->
    <xacro:macro name="cylinder_inertia" params="mass radius height *origin">
        <xacro:property name="r" value="${radius*radius}"/>
        <xacro:property name="h" value="${height*height}"/>
        <xacro:property name="m" value="${1/12*mass}"/>
        <inertial>
                <xacro:insert_block name="origin"/>
                <mass value="${mass}" />
                <inertia ixx="${m*(3*r+h)}" ixy="0.0" ixz="0.0"
                    iyy="${m*(3*r+h)}" iyz="0.0"
                    izz="${1/2*mass*(r)}" />
        </inertial>
    </xacro:macro>

</robot>